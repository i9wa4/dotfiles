#!/usr/bin/env bash

# Display system load (CPU temperature, CPU and RAM usage) for tmux status line.
#
# Usage:
#   system-load
#
# Output format:
#   TEMP:XXC CPU:XX% RAM:XX% DISK:XX% [BAT:XX% on battery-equipped macOS]
#
# Supported platforms:
#   - macOS (Darwin)
#   - Linux

os_type=$(uname -s)

get_darwin_macmon_metrics() {
  local sample
  command -v macmon >/dev/null 2>&1 || { printf '%s\t%s\t%s\n' - - -; return; }
  sample=$(macmon pipe --samples 1 -i 500 2>/dev/null) || { printf '%s\t%s\t%s\n' - - -; return; }
  printf '%s\n' "${sample}" | jq -er '
    [
      (if (.temp.cpu_temp_avg | type) == "number" then .temp.cpu_temp_avg | round else "-" end),
      (if (.pcpu_usage[1] | type) == "number" and (.ecpu_usage[1] | type) == "number"
       then ((.pcpu_usage[1] + .ecpu_usage[1]) * 100) | if . > 100 then 100 else . end | round
       else "-" end),
      (if (.memory.ram_usage | type) == "number" and (.memory.ram_total | type) == "number" and .memory.ram_total > 0
       then (.memory.ram_usage / .memory.ram_total * 100) | round else "-" end)
    ] | @tsv
  ' 2>/dev/null || printf '%s\t%s\t%s\n' - - -
}

# Get total CPU usage percentage
get_total_cpu_usage() {
  case "${os_type}" in
    Linux)
      # Parse /proc/stat for CPU usage
      local marker user nice system idle rest total1 total2 idle1 idle2 total_diff idle_diff
      read -r marker user nice system idle rest 2>/dev/null </proc/stat || { echo "-"; return; }
      if [[ ${marker} != cpu || ! ${user} =~ ^[0-9]+$ || ! ${nice} =~ ^[0-9]+$ || ! ${system} =~ ^[0-9]+$ || ! ${idle} =~ ^[0-9]+$ ]]; then
        echo "-"
        return
      fi
      total1=$((user + nice + system + idle))
      idle1=${idle}
      sleep 0.1
      read -r marker user nice system idle rest 2>/dev/null </proc/stat || { echo "-"; return; }
      if [[ ${marker} != cpu || ! ${user} =~ ^[0-9]+$ || ! ${nice} =~ ^[0-9]+$ || ! ${system} =~ ^[0-9]+$ || ! ${idle} =~ ^[0-9]+$ ]]; then
        echo "-"
        return
      fi
      total2=$((user + nice + system + idle))
      idle2=${idle}
      total_diff=$((total2 - total1))
      idle_diff=$((idle2 - idle1))
      if ((total_diff > 0 && idle_diff >= 0 && idle_diff <= total_diff)); then
        echo $(((total_diff - idle_diff) * 100 / total_diff))
      else
        echo "-"
      fi
      ;;
    *)
      echo "0"
      ;;
  esac
}

# Get RAM usage percentage
get_ram_usage() {
  case "${os_type}" in
    Linux)
      # /proc/meminfo: MemAvailable is the most accurate available memory
      local usage
      usage=$(awk '
        $1 == "MemTotal:" {total=$2; have_total=1}
        $1 == "MemAvailable:" {avail=$2; have_avail=1}
        END {
          if (have_total && have_avail && total ~ /^[0-9]+$/ && avail ~ /^[0-9]+$/ && total > 0 && avail <= total)
            printf "%.0f", (total-avail)*100/total
          else
            printf "-"
        }
      ' /proc/meminfo 2>/dev/null) || usage=-
      printf '%s' "${usage:--}"
      ;;
    *)
      echo "0"
      ;;
  esac
}

# Get CPU temperature in Celsius
get_cpu_temp() {
  case "${os_type}" in
    Linux)
      local temperature
      for zone_type_file in /sys/class/thermal/thermal_zone*/type; do
        [[ -r ${zone_type_file} ]] || continue
        if [ "$(cat "${zone_type_file}")" = "x86_pkg_temp" ]; then
          temp_file="${zone_type_file%/type}/temp"
          temperature=$(cat "${temp_file}" 2>/dev/null) || continue
          [[ ${temperature} =~ ^[0-9]+$ ]] || continue
          echo $((temperature / 1000))
          return
        fi
      done
      echo "-"
      ;;
    *)
      echo "-"
      ;;
  esac
}

# Get disk usage percentage for root filesystem
get_disk_usage() {
  case "${os_type}" in
    Darwin)
      # APFS: /System/Volumes/Data is the actual user data volume
      # (df / only shows the read-only system snapshot, misleadingly low)
      df -P /System/Volumes/Data 2>/dev/null | awk 'NR==2 && $5 ~ /^[0-9]+%$/ {sub(/%$/, "", $5); print $5}'
      ;;
    *)
      df -P / 2>/dev/null | awk 'NR==2 && $5 ~ /^[0-9]+%$/ {sub(/%$/, "", $5); print $5}'
      ;;
  esac
}

get_darwin_battery() {
  local battery_output
  command -v pmset >/dev/null 2>&1 || { printf ' BAT:-'; return; }
  battery_output=$(pmset -g batt 2>/dev/null) || { printf ' BAT:-'; return; }
  awk '
    /-InternalBattery/ {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9]+%;$/) {
          percentage = $i
          sub(/%;$/, "", percentage)
          if (percentage + 0 <= 100) printf " BAT:%d%%", percentage
          exit
        }
      }
    }
  ' <<<"${battery_output}"
}

# Main
case "${os_type}" in
  Darwin)
    read -r temp total_cpu ram <<<"$(get_darwin_macmon_metrics)"
    ;;
  *)
    temp=$(get_cpu_temp)
    total_cpu=$(get_total_cpu_usage)
    ram=$(get_ram_usage)
    ;;
esac
disk=$(get_disk_usage)
[[ ${disk} =~ ^[0-9]+$ ]] || disk=-

battery=""
if [[ ${os_type} == Darwin ]]; then
  battery=$(get_darwin_battery)
fi

printf "TEMP:%2sC CPU:%2s%% RAM:%2s%% DISK:%2s%%%s\n" "${temp}" "${total_cpu}" "${ram}" "${disk}" "${battery}"
